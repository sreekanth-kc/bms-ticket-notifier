# BookMyShow Movie Details
# Example: https://in.bookmyshow.com/movies/chennai/movie-title/ET00123456
BMS_URL="https://in.bookmyshow.com/movies/chennai/dhurandhar-the-revenge/buytickets/ET00478890"

# Dates to monitor (YYYYMMDD, comma-separated). Leave empty to use date from URL or all open dates
BMS_DATES=""

# Theatre filter (substring match, comma-separated, e.g. PVR,INOX). Leave empty for all theatres
BMS_THEATRE=""

# Time period filter (comma-separated: morning, afternoon, evening, night). Leave empty for all times
# morning: 06:00 - 12:00
# afternoon: 12:00 - 16:00
# evening: 16:00 - 19:00
# night: 19:00 - 24:00
BMS_TIME=""

# Resend Email Notification (https://resend.com)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_TO_EMAIL=""
